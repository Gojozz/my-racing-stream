import pytchat
import time
import os
import json
import tempfile
from pathlib import Path

VIDEO_ID = os.environ.get("YOUTUBE_LIVE_ID", "")
STATE_FILE = Path("chat_state.json")
MAX_PLAYERS = 5


def load_state():
    if not STATE_FILE.exists():
        return {
            "active": [],
            "queue": [],
            "lastUpdate": 0
        }

    try:
        with STATE_FILE.open("r", encoding="utf-8") as f:
            state = json.load(f)

        state.setdefault("active", [])
        state.setdefault("queue", [])
        state.setdefault("lastUpdate", 0)

        return state

    except Exception as e:
        print(f"[STATE ERROR] {e}")

        return {
            "active": [],
            "queue": [],
            "lastUpdate": 0
        }


def save_state(state):
    state["lastUpdate"] = time.time()

    # Tulis ke file sementara lalu replace.
    # Game tidak akan membaca file setengah jadi.
    fd, temp_path = tempfile.mkstemp(
        prefix="chat_state_",
        suffix=".tmp",
        dir="."
    )

    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(
                state,
                f,
                ensure_ascii=False,
                indent=2
            )
            f.flush()
            os.fsync(f.fileno())

        os.replace(temp_path, STATE_FILE)

    except Exception:
        try:
            os.unlink(temp_path)
        except Exception:
            pass

        raise


def normalize_user(user):
    return str(user).strip()


def already_joined(state, user):
    active_names = {
        p["user"].lower()
        for p in state["active"]
    }

    queue_names = {
        p["user"].lower()
        for p in state["queue"]
    }

    return (
        user.lower() in active_names
        or user.lower() in queue_names
    )


def add_player(state, user):
    if already_joined(state, user):
        return "already"

    player = {
        "user": user,
        "name": user,
        "joinedAt": time.time()
    }

    if len(state["active"]) < MAX_PLAYERS:
        state["active"].append(player)
        return "active"

    state["queue"].append(player)
    return "queue"


def start_bot():
    if not VIDEO_ID:
        print("ERROR: YOUTUBE_LIVE_ID belum diisi.")
        return

    print("====================================")
    print(" CHAT JOIN SYSTEM ONLINE")
    print(f" Live ID : {VIDEO_ID}")
    print(f" Max aktif : {MAX_PLAYERS}")
    print("====================================")

    state = load_state()
    save_state(state)

    chat = pytchat.create(video_id=VIDEO_ID)

    print(f"Bot mendengarkan live chat ID: {VIDEO_ID}")

    while chat.is_alive():

        try:
            for c in chat.get().sync_items():

                user = normalize_user(c.author.name)
                msg = c.message.lower().strip()

                if msg == "join" or msg.startswith("join "):

                    result = add_player(state, user)

                    if result == "active":
                        print(
                            f"[JOIN] {user} -> PEMBALAP AKTIF "
                            f"({len(state['active'])}/{MAX_PLAYERS})"
                        )

                        save_state(state)

                    elif result == "queue":
                        position = len(state["queue"])

                        print(
                            f"[QUEUE] {user} -> "
                            f"ANTREAN #{position}"
                        )

                        save_state(state)

                    else:
                        print(
                            f"[IGNORE] {user} sudah terdaftar"
                        )

        except Exception as e:
            print(f"[CHAT ERROR] {e}")

            time.sleep(2)

        time.sleep(0.2)


if __name__ == "__main__":
    start_bot()

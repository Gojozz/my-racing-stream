    // Kabin
    const cabinGeo = new THREE.BoxGeometry(
        1.55,
        0.5,
        1.9
    );

    const cabin = new THREE.Mesh(
        cabinGeo,
        glassMat
    );

    cabin.position.set(
        0,
        1.06,
        -0.2
    );


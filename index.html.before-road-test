        -0.25
    );

    carGroup.add(roof);


    // Spoiler
    const spoilerStandGeo = new THREE.BoxGeometry(
        0.12,
        0.5,
        0.12
    );

    const standL = new THREE.Mesh(
        spoilerStandGeo,
        darkMat
    );

    standL.position.set(
        -0.75,
        0.95,
        -2.05
    );

    carGroup.add(standL);

    const standR = standL.clone();

    standR.position.x = 0.75;
    carGroup.add(standR);


    const spoilerWingGeo = new THREE.BoxGeometry(
        1.9,
        0.1,
        0.5
    );

    const spoilerWing = new THREE.Mesh(
        spoilerWingGeo,
        darkMat
    );

    spoilerWing.position.set(
        0,
        1.2,
        -2.1
    );

    spoilerWing.castShadow = true;
    carGroup.add(spoilerWing);


    // Lampu depan
    const lightGeo = new THREE.BoxGeometry(
        0.45,
        0.16,
        0.08
    );

    const leftLight = new THREE.Mesh(
        lightGeo,
        lightMat
    );

    leftLight.position.set(
        -0.7,
        0.62,
        2.6
    );

    carGroup.add(leftLight);

    const rightLight = leftLight.clone();

    rightLight.position.x = 0.7;
    carGroup.add(rightLight);


    // Lampu belakang
    const tailGeo = new THREE.BoxGeometry(
        0.4,
        0.18,
        0.08
    );

    const leftTail = new THREE.Mesh(
        tailGeo,
        tailMat
    );

    leftTail.position.set(
        -0.75,
        0.68,
        -2.18
    );

    carGroup.add(leftTail);

    const rightTail = leftTail.clone();

    rightTail.position.x = 0.75;
    carGroup.add(rightTail);


    // Roda
    const wheelPositions = [
        [-1.05, 0.15, 1.35],
        [1.05, 0.15, 1.35],
        [-1.05, 0.15, -1.35],
        [1.05, 0.15, -1.35]
    ];

    wheelPositions.forEach(pos => {
        const wheel = createWheel();

        wheel.position.set(
            pos[0],
            pos[1],
            pos[2]
        );

        carGroup.add(wheel);
    });


    carGroup.traverse(obj => {
        if (obj.isMesh) {
            obj.castShadow = true;
        }
    });

    return carGroup;
}



/* =========================================================
   ANIMASI & LOGIKA BALAPAN
========================================================= */

const lapDisplay =
    document.getElementById('lap-display');

const leaderboardEl =
    document.getElementById('leaderboard');

const finishBanner =
    document.getElementById('finish-banner');

const posClasses = [
    'p1',
    'p2',
    'p3',
    'p4',
    'p5'
];

let clock = new THREE.Clock();


function animate() {

    requestAnimationFrame(animate);

    const time = clock.getElapsedTime();

    if (!isRaceFinished) {

        cars.forEach((car, index) => {

            // Variasi kecepatan dinamis
            const speedVariation =
                Math.sin(
                    time * 2 +
                    index * 100
                ) * 0.00022;

            const currentSpeed =
                car.baseSpeed +
                speedVariation;

            car.progress += currentSpeed;
            car.totalDistance += currentSpeed;


            // Hitung lap
            const newLap =
                Math.floor(car.totalDistance) + 1;

            if (newLap !== car.lap) {

                car.lap = newLap;

                if (car.lap > TOTAL_LAPS) {

                    isRaceFinished = true;

                    finishBanner.style.display =
                        'block';

                    setTimeout(() => {

                        cars.forEach((c, i) => {

                            c.progress =
                                i * 0.008;

                            c.totalDistance =
                                c.progress;

                            c.lap = 1;
                        });

                        isRaceFinished = false;

                        finishBanner.style.display =
                            'none';

                    }, 6000);
                }
            }


            // Pindah jalur
            car.laneOffset +=
                (
                    car.targetLane -
                    car.laneOffset
                ) * 0.05;


            // Posisi mobil
            const normProgress =
                car.progress % 1.0;

            const point =
                trackCurve.getPointAt(
                    normProgress
                );

            const tangent =
                trackCurve.getTangentAt(
                    normProgress
                );


            const sideVector =
                new THREE.Vector3(
                    -tangent.z,
                    0,
                    tangent.x
                ).normalize();


            const finalPosition =
                point.clone().add(
                    sideVector.multiplyScalar(
                        car.laneOffset
                    )
                );


            car.mesh.position.copy(
                finalPosition
            );

            car.mesh.position.y = 0;

            car.mesh.lookAt(
                finalPosition
                    .clone()
                    .add(tangent)
            );

        });


        // Tentukan pemimpin balapan
        const sortedCars =
            [...cars].sort(
                (a, b) =>
                    b.totalDistance -
                    a.totalDistance
            );


        // Update leaderboard
        leaderboardEl.innerHTML =
            sortedCars.map(
                (car, pos) => `
                    <div class="leader-item ${
                        posClasses[pos] || 'p5'
                    }">
                        <span>
                            P${pos + 1} - ${car.name}
                        </span>

                        <span>
                            LAP ${Math.min(
                                car.lap,
                                TOTAL_LAPS
                            )}
                        </span>
                    </div>
                `
            ).join('');



// Update lap utama
lapDisplay.innerText =
    `${Math.min(sortedCars[0].lap, TOTAL_LAPS)} / ${TOTAL_LAPS}`;

// Kamera mengikuti P1
const leaderCar = sortedCars[0];

const leaderNormProg =
    leaderCar.progress % 1.0;

const leaderPt =
    trackCurve.getPointAt(leaderNormProg);

const leaderTang =
    trackCurve.getTangentAt(leaderNormProg);

// Kamera dari belakang dan sedikit di atas
const camOffset =
    leaderTang.clone()
        .multiplyScalar(-24)
        .add(new THREE.Vector3(0, 12, 0));

camera.position.copy(
    leaderPt.clone().add(camOffset)
);

camera.lookAt(
    leaderPt.clone().add(
        leaderTang.clone().multiplyScalar(12)
    )
);

    }

    renderer.render(scene, camera);
}

// Mulai animasi
animate();

// Responsif terhadap perubahan ukuran layar
function resizeRenderer() {
    const width = window.innerWidth;
    const height = window.innerHeight;

    camera.aspect = width / height;
    camera.updateProjectionMatrix();

    renderer.setSize(width, height, false);
}

window.addEventListener('resize', resizeRenderer);

